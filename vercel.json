{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "tsc -b && vite build && tsx scripts/prerender.ts",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/fallback.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/corporate-catering-dubai",
      "destination": "/corporate",
      "statusCode": 301
    },
    {
      "source": "/healthcare-catering-dubai",
      "destination": "/luxury-dining-experiences",
      "statusCode": 301
    },
    {
      "source": "/school-catering-dubai",
      "destination": "/luxury-dining-experiences",
      "statusCode": 301
    },
    {
      "source": "/nursery-catering-dubai",
      "destination": "/luxury-dining-experiences",
      "statusCode": 301
    },
    {
      "source": "/university-catering-dubai",
      "destination": "/luxury-dining-experiences",
      "statusCode": 301
    },
    {
      "source": "/government-event-catering-dubai",
