{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "tsc -b && vite build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/healthcare-catering-dubai",
      "destination": "/luxury-dining-experiences",
      "statusCode": 301
    },
    {
      "source": "/school-catering-dubai",
      "destination": "/luxury-dining-experiences",
      "statusCode": 301
    },
    {
      "source": "/nursery-catering-dubai",
      "destination": "/luxury-dining-experiences",
      "statusCode": 301
    },
    {
      "source": "/university-catering-dubai",
      "destination": "/luxury-dining-experiences",
      "statusCode": 301
    },
    {
      "source": "/government-event-catering-dubai",
      "destination": "/luxury-dining-experiences",
      "statusCode": 301
    }
  ],
  "rewrites": [
    { "source": "/inquiry", "destination": "/index.html" },
    { "source": "/thank-you", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
